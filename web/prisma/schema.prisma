// Personal Life App — Prisma schema
// Grown slice-by-slice. See DATA_MODEL.md for the full intended model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Single-user preferences (theme toggle, etc.).
model UserSettings {
  id                    String   @id @default(cuid())
  theme                 String   @default("dawn") // dawn | sage
  eveningWorkoutEnabled Boolean  @default(false)
  updatedAt             DateTime @updatedAt
}

/// Lightweight event log powering the daily Claude review + "is it working?" signal.
model UsageEvent {
  id         String   @id @default(cuid())
  eventType  String
  metadata   Json?
  occurredAt DateTime @default(now())

  @@index([occurredAt])
}

/// Free-form, voice-first journaling — the spine of reflection.
model JournalEntry {
  id        String   @id @default(cuid())
  body      String
  mood      String? // optional, emergent — no fixed scale
  tags      String[] // emergent, no fixed taxonomy
  source    String   @default("text") // text | voice
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ---- Workout (habit-stacked morning routine; sets x reps that auto-ramp) ----

model Exercise {
  id        String        @id @default(cuid())
  name      String
  unit      String        @default("reps") // reps | seconds (plank = seconds, self-paced)
  sets      Int           @default(3)
  target    Int // current target per set; auto-increments on completed days
  increment Int           @default(1) // added to target each fully-completed day
  position  Int           @default(0)
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  items     WorkoutItem[]
}

model WorkoutDay {
  id        String        @id @default(cuid())
  date      DateTime      @unique @db.Date
  status    String        @default("active") // active | done | skipped
  createdAt DateTime      @default(now())
  items     WorkoutItem[]
}

model WorkoutItem {
  id           String     @id @default(cuid())
  workoutDay   WorkoutDay @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)
  workoutDayId String
  exercise     Exercise   @relation(fields: [exerciseId], references: [id])
  exerciseId   String
  unit         String     @default("reps")
  sets         Int // snapshot of target sets that day
  target       Int // snapshot of target per set that day
  setsDone     Int        @default(0)
  done         Boolean    @default(false)

  @@unique([workoutDayId, exerciseId])
}

model StepsLog {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  steps     Int      @default(0)
  createdAt DateTime @default(now())
}

// ---- Time / Schedule: the habit-stacked day (anchor chain, no clock times) ----

model Habit {
  id        String     @id @default(cuid())
  label     String
  cue       String // the anchor, e.g. "after the bathroom"
  note      String? // optional detail (room to grow into tasks later)
  kind      String     @default("plain") // plain | workout | steps | journal | evening
  link      String? // optional deep-link route (e.g. /workout)
  detail    Boolean    @default(false) // tap opens a detail screen (important items only); else inline check
  period    String     @default("morning") // morning | midday | evening | night (gradient bucket)
  position  Int        @default(0)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())
  logs      HabitLog[]
}

model HabitLog {
  id      String   @id @default(cuid())
  habit   Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  habitId String
  date    DateTime @db.Date
  done    Boolean  @default(true)
  doneAt  DateTime @default(now())

  @@unique([habitId, date])
}

// ---- Food: pantry stock (add when buying, reduce when cooking) ----

model PantryItem {
  id        String   @id @default(cuid())
  name      String
  quantity  Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
